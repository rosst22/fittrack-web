# Copy to .env.local and fill in. Never commit .env.local.
# Required — the app will not start a usable session without these.

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
# Dashboard -> Project Settings -> Data API. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable ("anon") key. Browser-safe by design; row access is
# still enforced server-side by Row Level Security. Use the Publishable key,
# never the Secret / service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Optional — each unlocks one feature; the rest of the app runs without it.

# USDA FoodData Central key, free at https://api.data.gov/signup/.
# Powers ingredient search (/api/food-search). Without it, search returns 500.
USDA_API_KEY=your-usda-fooddata-central-api-key

# Stripe Payment Link for the Pro subscription (optional).
# The upgrade page appends ?client_reference_id=<user id> so the stripe-webhook
# Edge Function knows who paid. Leave blank to hide upgrades entirely.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your-payment-link

# NOTE: there is no ANTHROPIC_API_KEY here on purpose. The AI features call
# Supabase Edge Functions (analyze-photo, coach-chat), which hold that key as a
# Supabase secret and enforce the per-tier daily quotas. Set it there with
# `supabase secrets set ANTHROPIC_API_KEY=...`, not in this file.

# Whoop developer app credentials from https://developer-dashboard.whoop.com.
# Powers the Whoop OAuth connect flow and recovery/sleep/strain/workout sync.
# The redirect URI must be https, so Whoop cannot be tested on localhost.
WHOOP_CLIENT_ID=your-whoop-client-id
WHOOP_CLIENT_SECRET=your-whoop-client-secret

# Deployment only — not needed for local development.

# Supabase secret (service-role) key. Bypasses Row Level Security, so it is
# server-only and must never be prefixed NEXT_PUBLIC_. Used by the nightly
# Whoop cron job to sync every user's data without a logged-in session.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# Shared secret the /api/cron/whoop route checks before running. Vercel sends
# it as a Bearer token on scheduled invocations. Any long random string.
CRON_SECRET=your-long-random-string
